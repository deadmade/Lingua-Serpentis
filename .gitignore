# Rust build artefacts. The unanchored form catches the inner cross-build's
# `target/` under `$OUT_DIR`, which the anchored one does not reach.
/target
target/

# direnv, driven by `.envrc` and the flake.
/.direnv

# insta's pending snapshots, written next to the blessed ones on a mismatch.
*.snap.new

# Editors and tools.
.idea/
.claude/settings.local.json

# graphify's knowledge graph and its caches, rebuilt locally.
graphify-out/
