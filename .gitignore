# Rust build artefacts. The unanchored form is not redundant with the anchored
# one: `crates/abi` is a second workspace with its own `target/`.
/target
target/

# direnv, driven by `.envrc` and the flake.
/.direnv

# insta's pending snapshots, written next to the blessed ones on a mismatch.
*.snap.new

# Editors and tools.
.idea/
.claude/settings.local.json
